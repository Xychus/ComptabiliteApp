<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration de Microsoft.Testing.Extensions.CodeCoverage (option coverage-settings). -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Ledger\.[^\\/]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <Sources>
      <Exclude>
        <!-- Racines de composition (Program.cs) : couvertes par les tests d'intégration à partir de la phase 3. -->
        <Source>.*[\\/]Program\.cs$</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
