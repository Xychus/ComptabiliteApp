<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Contrat OpenAPI généré au build (ADR 0019) et versionné dans docs/api, à côté de celui de
      l'API de commandes. Le test ContratOpenApiTests et l'étape « contrat OpenAPI à jour » du CI
      échouent s'il diverge.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\..\docs\api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name query-openapi --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Query.Application\Ledger.Query.Application.csproj" />
    <ProjectReference Include="..\Ledger.Query.Infrastructure\Ledger.Query.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contracts\Ledger.Contracts\Ledger.Contracts.csproj" />
  </ItemGroup>

</Project>
