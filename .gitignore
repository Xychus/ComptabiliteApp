## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Couverture de code
coverage/
*.cobertura.xml

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Surcharges locales (ex. backend local du premier apply de l'amorçage)
override.tf
*_override.tf
# Les modules ne sont pas des configurations racines : pas de verrou des fournisseurs
infra/modules/**/.terraform.lock.hcl
# Fichiers de variables locaux. Dépôt public : les variables d'amorçage (numéro de compte,
# rôles d'administration) restent hors de Git ; seul l'exemple est versionné.
*.auto.tfvars
infra/bootstrap/*.tfvars
!infra/bootstrap/exemple.tfvars
__pycache__/
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.vs/
.idea/
*.user
