{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    { "type": "feat", "section": "Fonctionnalités" },
    { "type": "fix", "section": "Corrections" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactorisation", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Maintenance", "hidden": true }
  ],
  "packages": {
    "src/Command": { "component": "command" },
    "src/Projections": { "component": "projections" },
    "src/Query": { "component": "query" },
    "src/Authorizer": { "component": "authorizer" },
    "src/Contracts": { "component": "contracts" },
    "infra": { "component": "infra" }
  }
}
